FROM node:24-bookworm-slim AS builder

RUN npm install --global pnpm@11.6.0
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/sdk/package.json ./sdk/package.json
COPY web/admin/package.json ./admin/package.json
RUN pnpm install --frozen-lockfile
COPY web/sdk ./sdk
COPY web/admin ./admin
RUN pnpm build

FROM nginx:1.28-alpine
COPY deploy/offline/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/web/admin/dist /usr/share/nginx/html
EXPOSE 80

